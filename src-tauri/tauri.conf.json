{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pro-Art Mail",
  "version": "../package.json",
  "identifier": "nl.pro-art.mail",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Pro-Art Mail",
        "width": 1400,
        "height": 880,
        "minWidth": 1000,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: http:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Pro-Art",
    "shortDescription": "Mail voor de winkel",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Dutch"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4MkY2ODQ2NzdDRDQ1QzgKUldUSVJjMTNSbWd2U003Y2JmTUR1T2RJeFdrNDVDMS9PS1pYL0dBbkV0UWxRZWdoZTg0L29GaVoK",
      "endpoints": [
        "https://github.com/roppunt/pro-art-mail/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}